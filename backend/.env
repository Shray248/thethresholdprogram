# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (Prisma / MySQL)
# Replace with your actual MySQL database credentials when deploying
DATABASE_URL="mysql://user:pass@localhost:3306/threshold"

# Authentication
# Generate a random string for this in production
JWT_SECRET="super_secret_threshold_jwt_key_123!"
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Razorpay Configuration (Test Mode Keys)
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Course Pricing (in smallest currency unit, e.g. cents)
COURSE_PRICE_USD=49700
COURSE_PRICE_EUR=45700
COURSE_PRICE_GBP=39700
COURSE_PRICE_INR=1400000

# 1-on-1 Session Pricing
SESSION_PRICE_USD=19700
SESSION_PRICE_EUR=17700
SESSION_PRICE_GBP=14700
SESSION_PRICE_INR=1650000