# ═══════════════════════════════════════════════════════════
# THE THRESHOLD PROGRAM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/threshold_db?schema=public"

# ─── Authentication ───────────────────────────────────────
JWT_SECRET=your-256-bit-secret-here-change-this-in-production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─── Course Pricing (in smallest currency unit, e.g. cents) ─
COURSE_PRICE_USD=49700
COURSE_PRICE_EUR=45700
COURSE_PRICE_GBP=39700
COURSE_PRICE_INR=4150000

# ─── 1-on-1 Session Pricing ──────────────────────────────
SESSION_PRICE_USD=19700
SESSION_PRICE_EUR=17700
SESSION_PRICE_GBP=14700
SESSION_PRICE_INR=1650000
