// ═══════════════════════════════════════════════════════════
// THE THRESHOLD PROGRAM — PRISMA DATABASE SCHEMA
// PostgreSQL · Relational · Production-ready
// ═══════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── User Model ──────────────────────────────────────────
// Core identity. Every user has a role, access level, and
// a relationship to their orders and course progress.
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  role          Role     @default(USER)

  // Access control — flipped to true after successful payment
  hasPurchased  Boolean  @default(false)
  accessLevel   AccessLevel @default(FREE)

  // Razorpay customer ID
  razorpayCustomerId String? @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  orders        Order[]
  progress      CourseProgress[]

  @@index([email])
  @@map("users")
}

// ─── Order / Transaction Model ───────────────────────────
// Immutable ledger of every payment attempt. Never deleted.
model Order {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Razorpay references — these are the source of truth
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?

  // Financial data
  amount              Int         // Amount in smallest currency unit (cents/paise)
  currency            String      @default("usd")
  status              OrderStatus @default(PENDING)
  productType         ProductType @default(FULL_PROGRAM)

  // Metadata
  receiptUrl          String?
  failureReason       String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("orders")
}

// ─── Course Progress Model ───────────────────────────────
// Tracks which modules/lessons a user has completed.
// One row per user-module combination.
model CourseProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  moduleId    String   // e.g. "phase-1", "phase-2", etc.
  lessonId    String   // e.g. "lesson-1-1", "lesson-1-2", etc.
  completed   Boolean  @default(false)
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A user can only have one progress record per lesson
  @@unique([userId, moduleId, lessonId])
  @@index([userId])
  @@map("course_progress")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AccessLevel {
  FREE
  FULL_PROGRAM
  SESSION_ONLY
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProductType {
  FULL_PROGRAM
  PRIVATE_SESSION
}
